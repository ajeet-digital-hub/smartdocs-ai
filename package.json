{
  "name": "smartdocs-ai",
  "version": "1.0.0",
  "private": true,
  "description": "SmartDocs AI - Full-stack AI SaaS platform (Frontend: Next.js 16, Backend: Express.js)",
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:all": "concurrently \"npm:dev:frontend\" \"npm:dev:backend\"",
    "build": "cd frontend && npm run build",
    "start": "cd frontend && npm run start",
    "lint": "cd frontend && npm run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "bcrypt": "^6.0.0",
    "mongodb": "^7.5.0",
    "multer": "^2.2.0",
    "twilio": "^6.0.2"
  }
}
